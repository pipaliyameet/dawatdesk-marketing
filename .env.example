# ==============================================================================
# DAWATDESK MARKETING & SALES PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env.local`: `cp .env.example .env.local`
# 2. Fill in your actual credentials.
# 3. NEVER commit `.env.local` or any secrets to source control.
# ==============================================================================

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?appName=Cluster0
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?appName=Cluster0

# MongoDB Database Name for marketing leads (demo requests & contact queries)
MONGODB_DB=dawatdesk_marketing

# Official Live DawatDesk Restaurant POS Application URL
NEXT_PUBLIC_APP_URL=https://dawatdesk.vercel.app

# Public Marketing Website URL
NEXT_PUBLIC_SITE_URL=https://dawatdesk-marketing.vercel.app
